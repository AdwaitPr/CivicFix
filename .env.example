# CivicFix Environment Configuration

# Provider selection: 'local' (SQLite) or 'supabase' (PostgreSQL + PostGIS)
# When set to 'supabase', missing or invalid Supabase credentials will throw an explicit configuration error.
CIVICFIX_DATA_MODE=local

# Local SQLite Database Path (used when CIVICFIX_DATA_MODE=local)
SQLITE_DB_PATH=./data/civicfix.sqlite

# Supabase Configuration (required when CIVICFIX_DATA_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenStreetMap / Custom Raster Tile Provider
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Cryptographic Salt for IP Address Hashing (Rate Limiting)
IP_HASH_SALT=civicfix-production-salt-replace-in-prod
